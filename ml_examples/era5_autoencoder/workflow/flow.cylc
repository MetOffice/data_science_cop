#!jinja2
# to run this workflow, use the following command:
# cylc vip --set-file flow.opt


[scheduling]
    cycling mode = integer
    initial cycle point = 1
    final cycle point = {{ NUM_EPOCHS }}

    [[graph]]
        R1 = """
        init_tasks => data_prep => train_model
        """

        P1 = """
        train_model[-P1] => train_model => evaluate_model
        """

[runtime]
    [[root]]

    [[SPICE_CPU]]
        platform = spice
        [[[directives]]]
        --partition = cpu
        --mem = 8G
        --ntasks = 1

    [[SPICE_GPU]]
        platform = slx
        [[[directives]]]
            --partition = gpu
            --gres = gpu:1
            --mem = 0
            --ntasks = 40

    [[init_tasks]]
        inherit = SPICE_CPU
        script = """
        echo Create shared directories for training data, model output, and evaluation results
        mkdir -p {{TRAINING_DATA_DIR}}
        mkdir -p {{MODEL_OUTPUT_DIR}}
        mkdir -p {{EVALUATION_DIR}}
        """
        execution time limit = PT5M


    [[data_prep]]
    inherit = SPICE_CPU
    script = """{{REPO_ROOT}}/{{SCRIPT_REL_DIR}}/run_era5_autoencoder_data_prep.sh {{REPO_ROOT}} {{TRAINING_DATA_DIR}} {{CONDA_ENV_NAME}}"""
    execution time limit = PT1H
        [[[directives]]]
            --ntasks = 8
            --mem = 64G
        [[[environment]]]
            RESOLUTIONS="{{RESOLUTIONS}}"



    [[train_model]]
        inherit = SPICE_GPU
        execution time limit = PT20M
        # need to specify the output file for each epoch explicitly
        script = """{{REPO_ROOT}}/{{SCRIPT_REL_DIR}}/run_era5_autoencoder_training.sh {{REPO_ROOT}} {{ARTIFACTS_DIR}} {{TRAINING_DATA_DIR}} {{MODEL_OUTPUT_DIR}} {{CONDA_ENV_NAME}} """
        [[[directives]]]
            --ntasks = 4
            --mem = 32G

        [[[environment]]]
            LEARNING_RATE = {{LEARNING_RATE}}
            BATCH_SIZE = {{BATCH_SIZE}}
            START_EPOCH_NUM = $((CYLC_TASK_CYCLE_POINT-1))
            NUM_EPOCHS = 1 # do 1 epoch to split up training into smaller jobs for better scheduling and reduced queue times

    [[evaluate_model]]
        inherit = SPICE_CPU
        script = """{{REPO_ROOT}}/{{SCRIPT_REL_DIR}}/run_era5_autoencoder_evaluation.sh {{REPO_ROOT}} {{TRAINING_DATA_DIR}} {{MODEL_OUTPUT_DIR}} {{EVALUATION_DIR}} {{CONDA_ENV_NAME}}"""
        execution time limit = PT20M
        # need to specify the output file for each epoch explicitly
        [[[directives]]]
            --ntasks = 4
            --mem = 16G


